{
  "name": "daly-vet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cf:dev": "wrangler pages dev dist --d1=DB=daly-vet-db",
    "db:local": "wrangler d1 execute daly-vet-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute daly-vet-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "qrcode.react": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10",
    "wrangler": "^3.84.0"
  }
}
